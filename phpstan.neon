includes:
    - vendor/larastan/larastan/extension.neon
    - phpstan-baseline.neon

parameters:
    paths:
        - app

    # Level 9 — level tertinggi & paling ketat untuk static analysis
    level: 9

    # Casts / enum PHPDoc sering terlalu "certain" di Larastan → noise instanceof/narrowing
    treatPhpDocTypesAsCertain: false

    excludePaths:
        - app/Http/Middleware/EnsureRole.php
