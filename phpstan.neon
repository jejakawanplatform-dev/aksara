includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app

    # Level 5 — seimbang antara strict dan praktis untuk workshop
    level: 5

    # Casts / enum PHPDoc sering terlalu "certain" di Larastan → noise instanceof/narrowing
    treatPhpDocTypesAsCertain: false

    excludePaths:
        - app/Http/Middleware/EnsureRole.php
